OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M

# WhatsApp hub-physician escalation (RED triage only)
# Digits only or with '+', spaces/dashes are stripped. Leave blank to let the
# CHW pick the contact in WhatsApp at send time.
HUB_PHYSICIAN_PHONE=
HUB_PHYSICIAN_NAME=Hub Physician

# Optional — name of the WhatsApp hub-and-spoke group the CHW pastes into.
# Example: "TVMCH Cardiology Hub and Spoke"
# WhatsApp has no group-chat deep link, so the demo UI shows a "Copy to <group>"
# button alongside the single-contact Send button. The escalation text is
# identical either way.
HUB_GROUP_NAME=

# Identifies the originating PHC/CHW in the escalation message (shown to hub).
FACILITY_NAME=Spoke clinic
CHW_NAME=

# Transport context — distance to the nearest hub hospital and average
# ambulance speed. If NEAREST_HUB_KM > 0, RED escalations include a
# "Transport ETA: ~N min (K km to <hub>)" line so the receiving team
# knows roughly when to expect the patient.
NEAREST_HUB_KM=0
AVG_AMBULANCE_KMH=50

# Public base URL where this server is reachable from the hub physician's
# phone (no trailing slash). When set, a RED escalation message that has
# an image attached includes the tappable image URL so the hub can view
# the ECG straight from WhatsApp. Leave empty for laptop-only / offline.
PUBLIC_BASE_URL=
